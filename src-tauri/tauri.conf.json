{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nitean Studio",
  "version": "0.3.0",
  "identifier": "com.nitean.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nitean Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Nitean Studio",
    "shortDescription": "Narrated explainer videos in Khmer or English",
    "category": "Video",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "resources/sdcpp/": "sdcpp/",
      "resources/audiocpp/": "audiocpp/",
      "binaries/FFMPEG-LICENSE.txt": "licenses/FFMPEG-LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2ODA3OTc3N0U2OTdFQTgKUldTb2ZtbCtkM21BRmovQjkvRms5OERNQXJhUzZ3UnBDQUptRCtMTGMxL25WOGZjSmVLdy9xVjcK",
      "endpoints": [
        "https://github.com/Narak76543/niteam-studio/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
